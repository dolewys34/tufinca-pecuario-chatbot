# Copia este archivo a ".env" y completa los valores.
# Sin estos valores, el chatbot funciona con el motor de reglas (modo desarrollo).

# --- Azure AI Foundry / Azure OpenAI ---
# En el portal de Azure AI Foundry: despliega un modelo (p. ej. gpt-4o-mini)
# y copia el endpoint, la clave y el nombre del despliegue.
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com
AZURE_OPENAI_API_KEY=tu-clave-secreta
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Telegram (canal de mensajería del chatbot) ---
# 1. En Telegram habla con @BotFather → /newbot → sigue los pasos.
# 2. Pega aquí el token que te entrega:
TELEGRAM_BOT_TOKEN=

# --- Base de datos (opcional; por defecto usa SQLite local) ---
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/tufinca

# --- CORS (orígenes del frontend permitidos) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
